{
    "name": "hyun-hub",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "bun run --hot index.ts",
        "build": "bun build ./index.ts --outfile ./api/index.js --target bun --format esm",
        "vercel-build": "bun build ./index.ts --outfile ./api/index.js --target bun --format esm --external @google/genai --external cheerio",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "test:coverage": "bun test --coverage",
        "db:generate": "drizzle-kit generate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1078.0",
        "@aws-sdk/s3-request-presigner": "^3.1078.0",
        "@google/genai": "^2",
        "@hono/swagger-ui": "^0.6",
        "@hono/zod-validator": "^0.7.6",
        "@resvg/resvg-wasm": "^2.6.2",
        "@sentry/bun": "^10",
        "better-auth": "^1.6",
        "cheerio": "^1.2.0",
        "dayjs": "^1.11.21",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.11.9",
        "hono-openapi": "^0.4.8",
        "icojs": "^1",
        "imapflow": "^1.4.3",
        "ioredis": "^5.11.1",
        "mailparser": "^3.9.12",
        "mysql2": "^3.22.5",
        "nodemailer": "^9",
        "rrule": "^2.8.1",
        "satori": "^0.26",
        "sharp": "^0.35",
        "tw-to-css": "^0.0.12",
        "zod": "^3.25.76",
        "zod-openapi": "^4.2.4"
    },
    "devDependencies": {
        "@fontsource/inter": "^5.2.8",
        "@fontsource/noto-sans-kr": "^5.2.9",
        "@types/bun": "latest",
        "@types/mailparser": "^3.4.6",
        "@types/nodemailer": "^8",
        "drizzle-kit": "^0.31.10",
        "feconfig-bhs": "^1.0.7",
        "typescript": "^6"
    }
}
