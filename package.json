{
    "name": "hyun-hub",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "bun run --hot index.ts",
        "build": "bun build ./index.ts --outfile ./api/index.js --target bun --format esm",
        "vercel-build": "bun build ./index.ts --outfile ./api/index.js --target bun --format esm --external @google/genai",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "test:coverage": "bun test --coverage",
        "db:generate": "drizzle-kit generate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.916.0",
        "@google/genai": "^1.40.0",
        "@hono/swagger-ui": "^0.5.3",
        "@hono/zod-validator": "^0.7.6",
        "@resvg/resvg-wasm": "^2.6.2",
        "@sentry/bun": "^9.27.0",
        "better-auth": "^1.3.29",
        "drizzle-orm": "^0.45.1",
        "hono": "^4.11.8",
        "hono-openapi": "^0.4.6",
        "icojs": "^0.20.1",
        "mysql2": "^3.16.3",
        "satori": "^0.19.1",
        "sharp": "^0.34.4",
        "zod": "^3.24.0",
        "zod-openapi": "4"
    },
    "devDependencies": {
        "@fontsource/inter": "^5.2.8",
        "@fontsource/noto-sans-kr": "^5.2.9",
        "@types/bun": "latest",
        "drizzle-kit": "^0.31.8",
        "feconfig-bhs": "^1.0.7",
        "typescript": "^5.8.3"
    }
}
